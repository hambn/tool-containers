// Copy to .devcontainer/devcontainer.json in your project.
{
  "name": "devbox",
  "image": "ghcr.io/hambn/devbox:ubuntu-full",
  // Naming the user lets Linux hosts remap sysadmin to your UID, so /workspace files keep your ownership.
  "remoteUser": "sysadmin",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  // Headless Chromium on the *-browser variants needs more than the 64 MB default /dev/shm.
  "runArgs": ["--shm-size=1g"]
}
