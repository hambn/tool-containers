{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  semanticCommits: "enabled",
  // Renovate merges only after every check on the branch has passed, without
  // depending on branch protection settings.
  platformAutomerge: false,
  internalChecksFilter: "strict",
  // validate_pr_metadata.py requires these sections in every non-Dependabot PR body.
  prHeader: "## Summary\n\nAutomated dependency update by Renovate; details below.",
  prFooter: "## Validation\n\n- The pull request gate and each tool workflow builds, tests, and scans its images on this pull request.",
  customManagers: [
    {
      // Container images pinned as name:tag@sha256:digest.
      customType: "regex",
      description: "Image pins in tool Dockerfiles",
      managerFilePatterns: ["/^tools/.+/Dockerfile$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\nARG \\w+=[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
    },
    {
      // Plain versions; the value must not contain a digest.
      customType: "regex",
      description: "Tool versions in tool Dockerfiles",
      managerFilePatterns: ["/^tools/.+/Dockerfile$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+=(?<currentValue>[^@\\s]+)\\n',
      ],
    },
    {
      // Git commits tracked against a branch (currentValue) with the commit as digest.
      customType: "regex",
      description: "Git commit pins in tool Dockerfiles",
      managerFilePatterns: ["/^tools/.+/Dockerfile$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\nARG \\w+=(?<currentDigest>[a-f0-9]{40})',
      ],
    },
  ],
  customDatasources: {
    // The Cursor installer embeds the current version in its download URL:
    // https://downloads.cursor.com/lab/<version>/linux/x64/agent-cli-package.tar.gz
    "cursor-agent": {
      defaultRegistryUrlTemplate: "https://cursor.com/install",
      format: "plain",
      transformTemplates: [
        '{"releases": [{"version": $substringBefore($substringAfter(releases[$contains(version, "downloads.cursor.com/lab/")][0].version, "downloads.cursor.com/lab/"), "/")}]}',
      ],
    },
  },
  packageRules: [
    {
      description: "Cursor versions are dated builds: YYYY.MM.DD-<commit>",
      matchDatasources: ["custom.cursor-agent"],
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})-[0-9a-f]+$",
    },
    {
      description: "Agent CLIs: automerge minor and patch updates once CI passes",
      matchFileNames: ["tools/**/Dockerfile"],
      matchDatasources: ["npm", "pypi", "custom.cursor-agent"],
      matchDepNames: [
        "@anthropic-ai/claude-code",
        "@openai/codex",
        "@earendil-works/pi-coding-agent",
        "@alibaba-group/open-code-review",
        "@xai-official/grok",
        "opencode-ai",
        "@github/copilot",
        "@google/gemini-cli",
        "cursor-agent",
        "acp-agent",
        "omnigent",
      ],
      matchUpdateTypes: ["minor", "patch"],
      // Skip releases that get pulled or turn out broken within their first days.
      minimumReleaseAge: "2 days",
      automerge: true,
    },
    {
      description: "T3 Code: follow stable and nightly npm releases after image CI passes",
      matchFileNames: ["tools/ai/t3code/Dockerfile"],
      matchDatasources: ["npm"],
      matchDepNames: ["t3"],
      ignoreUnstable: false,
      respectLatest: false,
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+(?:-nightly\\.\\d{8}\\.\\d+)?$/",
      automerge: true,
    },
    {
      description: "Base images and the devbox toolchain: one weekly group",
      matchFileNames: ["tools/**/Dockerfile"],
      matchDepNames: [
        "docker.io/library/alpine",
        "docker.io/library/ubuntu",
        "docker.io/chainguard/wolfi-base",
        "docker.io/chromedp/headless-shell",
        "kubernetes/kubernetes",
        "helm/helm",
        "kubernetes-sigs/kustomize",
        "mikefarah/yq",
        "cli/cli",
        "gitlab-org/cli",
        "tailscale/tailscale",
        "astral-sh/uv",
        "go",
        "node",
        "pnpm",
        "yarn",
        "zsh-users/zsh-autosuggestions",
        "https://github.com/ohmyzsh/ohmyzsh",
      ],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      groupName: "base images and devbox toolchain",
      schedule: ["before 6am on monday"],
      minimumReleaseAge: "3 days",
      automerge: true,
    },
    {
      description: "Majors always need a manual review in their own pull request",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["major"],
    },
    {
      description: "T3 Code nightlies automerge after CI, including a new release line",
      matchFileNames: ["tools/ai/t3code/Dockerfile"],
      matchDepNames: ["t3"],
      matchNewValue: "/-nightly\\./",
      automerge: true,
    },
    {
      description: "Held: newer releases conflict with the distro Python packages acp-agent runs beside",
      matchDepNames: ["agent-client-protocol"],
      enabled: false,
    },
    {
      description: "GitHub Actions digest pins in one pull request",
      matchManagers: ["github-actions"],
      groupName: "github actions",
      semanticCommitType: "chore",
      semanticCommitScope: "actions",
    },
    {
      description: "Web UI npm dependencies",
      matchManagers: ["npm"],
      matchFileNames: ["web-ui/**"],
      groupName: "web-ui dependencies",
      semanticCommitScope: "web-ui",
    },
    {
      description: "Validation dependency",
      matchManagers: ["pip_requirements"],
      semanticCommitType: "chore",
      semanticCommitScope: "python",
    },
    {
      description: "Tool Dockerfiles pin through the regex managers above; FROM lines use build args",
      matchManagers: ["dockerfile"],
      matchFileNames: ["tools/**"],
      enabled: false,
    },
    {
      description: "Our own images in examples use moving tags on purpose",
      matchPackageNames: ["ghcr.io/hambn/**", "docker.io/hambn/**", "hambn/**"],
      enabled: false,
    },
  ],
}
